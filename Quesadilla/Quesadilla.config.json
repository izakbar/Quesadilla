  "CSSData": [
    {
      "Name": "OBS.MiningTable",
      "FriendlyName": "OBS Mining Table",
      "CSS": "\r\n.miningcontainer {\r\n  width: 100%;\r\n  position: relative;\r\n}\r\n.miningperhour {\r\n  border: 3px solid transparent;\r\n  border-radius: 15px;\r\n  outline: 2px solid Gold;\r\n\r\n  display: inline-block;\r\n  position: absolute;\r\n\r\n  color: green;\r\n  font-size: 24px;\r\n\r\n  margin: auto;\r\n}\r\n.miningTable {\r\n        display:  table;\r\n        width:auto;\r\n        background-color:#eee;\r\n        border:1px solid  #666666;\r\n        border-spacing:5px;/*cellspacing:poor IE support for  this*/\r\n       /* border-collapse:separate;*/\r\n}\r\n.miningRow {\r\n       display:table-row;\r\n       width:auto;\r\n }\r\n\r\n.miningItem {\r\n        float:left;\r\n        display:table-column;\r\n        width:350px;\r\n        color: CornflowerBlue;\r\n        padding-left:30px;\r\n }\r\n.miningCharacter {\r\n        float:left;\r\n        display:table-column;\r\n        width:100%;\r\n        padding-left:5px;\r\n }\r\n.miningAmount {\r\n        float:left;\r\n        display:table-column;\r\n        width:70px;\r\n        text-align: right;\r\n        padding-right:5px;\r\n }\r\n.miningWastage {\r\n        float:left;\r\n        display:table-column;\r\n        width:70px;\r\n        color: Red;\r\n        text-align: right;\r\n        padding-right:5px;\r\n }\r\n"
    },
    {
      "Name": "OBS.Mining",
      "FriendlyName": "OBS Mining Info",
      "CSS": "\r\n.miningcontainer {\r\n  width: 100%;\r\n  position: relative;\r\n}\r\n.miningperhour {\r\n  border: 3px solid transparent;\r\n  border-radius: 15px;\r\n  outline: 2px solid Gold;\r\n\r\n  display: inline-block;\r\n  position: absolute;\r\n\r\n  color: green;\r\n  font-size: 24px;\r\n\r\n  margin: auto;\r\n}\r\n"
    },
    {
      "Name": "OBS.ISK",
      "FriendlyName": "OBS ISK Value",
      "CSS": "\r\n.iskcontainer {\r\n  width: 100%;\r\n  position: relative;\r\n}\r\n.iskperhour {\r\n  border: 3px solid transparent;\r\n  border-radius: 15px;\r\n  outline: 2px solid Gold;\r\n\r\n  display: inline-block;\r\n  position: absolute;\r\n\r\n  color: green;\r\n  font-size: 24px;\r\n\r\n  margin: auto;\r\n}\r\n"
    },
    {
      "Name": "OBS.LatestAlert",
      "FriendlyName": "OBS Latest Alert",
      "CSS": "\r\n.alert {\r\n  border: 3px solid transparent;\r\n  border-radius: 15px;\r\n  outline: 2px solid Gold;\r\n\r\n  display: inline-block;\r\n  position: relative;\r\n}\r\n"
    },
    {
      "Name": "OBS.ZkillList",
      "FriendlyName": "OBS Zkill Listing",
      "CSS": "\r\nimg.rounded-corners {\r\n  border-radius: 50%;\r\n    border: 1px solid red;\r\n}\r\n.zkill {\r\n  background-color: #0a0e15;\r\n    border: 3px solid transparent;\r\n  border-radius: 15px;\r\n  outline: 2px solid steelblue;\r\n  display: inline-block;\r\n  position: relative;\r\n}\r\n.zkillkill {\r\n  display: block;\r\n  position: relative;\r\n  background-color: #0a0e15;\r\n  width:240px;\r\n  height: 90px;\r\n}\r\n\r\n.zkillkill:not(:last-child) {\r\n  border-bottom: 2px solid steelblue;\r\n}\r\n\r\n\r\n.zkill-ship {\r\n  width:80px;\r\n  top: 6px;\r\n  position: absolute;\r\n}\r\n.zkill-victim {\r\n  color: cadetblue;\r\n  position: absolute;\r\n  top: 35px;\r\n  left: 85px;\r\n  font-size: 15px;\r\n  text-align: left; width: 65%;\r\n}\r\n.zkill-shipname {\r\n  color: lightgray;\r\n  position: absolute;\r\n  top: 50px;\r\n  left: 85px;\r\n  font-size: 13px;\r\n  text-align: left; width: 65%;\r\n}\r\n.zkill-value {\r\n  color: white;\r\n  background-color: LimeGreen;\r\n  position: absolute;\r\n  top: 65px;\r\n  left: 50px;\r\n  font-size: 18px;\r\n  border-radius: 20%;\r\n}\r\n\r\n.zkill-timestamp {\r\n  color: lightgoldenrodyellow;\r\n  position: absolute;\r\n  top: 2px;\r\n  left: 5px;\r\n  font-size: 15px;\r\n  border-radius: 20%;\r\n}\r\n.zkill-killer {\r\n    visibility: hidden;\r\n}\r\n.zkill-region {\r\n  color: white;\r\n  position: absolute;\r\n  top: 5px;\r\n  left: 83px;\r\n  text-align: right; width: 65%;\r\n  font-size: 15px;\r\n}\r\n.zkill-system {\r\n  color: orange;\r\n  position: absolute;\r\n  top: 22px;\r\n  left: 83px;\r\n  text-align: right; width: 65%;\r\n  font-size: 12px;\r\n}\r\n\r\n.zkill-killer-logo\r\n{\r\n    visibility: hidden;\r\n}\r\n\r\n.zkill-victim-logo\r\n{\r\n    visibility: hidden;\r\n}\r\n\r\n.zkill-victim-alliance \r\n{\r\n    visibility: hidden;\r\n}\r\n.zkill-victim-corporation\r\n{\r\n    visibility: hidden;\r\n}"
    }
  ],
